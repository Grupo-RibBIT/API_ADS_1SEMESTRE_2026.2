from duckduckgo_search import DDGS
import telebot
import dspy

# Substitua pelo token gerado pelo BotFather
TOKEN = "Seu_Token"
bot = telebot.TeleBot(TOKEN)

# Substitua pelo seu chat_id numérico (ex: 123456789)
CHAT_ID = "Seu_Chat_ID

# Parte relacionada a função de buscador (US1 - A)
@bot.message_handler(commands=["start", "ajuda"])
def enviar_pergunta(mensagem):
    # O bot envia a mensagem e registra qual função deve ser chamada a seguir
    msg = bot.send_message(
        mensagem.chat.id, "Deseja notícias de qual localidade?"
    )
    bot.register_next_step_handler(msg, processar_nome)
    return mensagem

def processar_nome(mensagem):
    # 'mensagem.text' contém o input digitado pelo usuário
    localidade = mensagem.text
    bot.send_message(
        mensagem.chat.id,
        f"Obrigado! Já já iremos apresentar notícias da localidade {localidade} que você escolheu, para sua comodidade!",
    )

    # Chamar a busca e o envio de notícias dentro do fluxo após receber a localidade
    enviar_noticias(mensagem.chat.id, localidade)
    return mensagem

def enviar_noticias(chat_id, localidade):
    try:
        # Parte Relacionada a função output das notícias (US1 - B)
        results = DDGS().news(query=localidade, max_results=5)

        texto_formatado = ""
        for i, noticia in enumerate(results, 1):
            texto_formatado += f"Notícia {i}:\n"
            texto_formatado += f"Título: {noticia.get('title')}\n"
            texto_formatado += f"Data: {noticia.get('date')}\n"
            texto_formatado += f"Fonte: {noticia.get('source')}\n"
            texto_formatado += f"Link: {noticia.get('url')}\n"
            texto_formatado += f"Resumo: {noticia.get('body')}\n"
            texto_formatado += "-" * 40 + "\n"

        if not texto_formatado:
            texto_formatado = f"Nenhuma notícia encontrada para: {localidade}"

        # Exibe o texto final no console e envia para o chat
        print(texto_formatado)
        bot.send_message(chat_id, texto_formatado)
    except Exception as e:
        print(f"Erro ao buscar notícias: {e}")
        bot.send_message(chat_id, "Desculpe, ocorreu um erro ao buscar as notícias.")

bot.infinity_polling()
