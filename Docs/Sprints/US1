from newsapi import NewsApiClient
import requests

# Insira aqui o Token do seu bot (obtido com o @BotFather)
TOKEN = "Seu_Token"
# Insira aqui o ID do chat ou canal
CHAT_ID = "Seu_Chat_ID"
# Inicialize o cliente com a sua chave de API
newsapi = NewsApiClient(api_key="Sua_Chave_do_News_API_que_pode_ser_criado_no_site_do_News_API")

# Busca por notícias (input) que recebe por entrada um dos diálogos do bot

x = input("Digite o assunto da notícia: ")

# Modelo de filtro simples, com o gerador de notícias da biblioteca News API
top_headlines = newsapi.get_everything(
    q=f"Me mostre notícias positivas da região de {x}",
    language="pt",
    sort_by="publishedAt",
    page_size=5,  # Quantidade de notícias que deseja exibir
)

lista = []

lista_maior = []

# Parte que imprime os títulos e as fontes das notícias
if top_headlines["status"] == "ok":
  articles = top_headlines["articles"]
  for i, article in enumerate(articles, 1):
    print(f"{i}. {article['title']}")
    print(f"   Fonte: {article['source']['name']}")
    print(f"   Link: {article['url']}\n")

    lista = [

      f"{i}. {article['title']}"
      f"   Fonte: {article['source']['name']}"
      f"   Link: {article['url']}\n"
    
    ]

    lista_maior.append(lista)



    
else:
  print("Erro ao buscar notícias.")

#Parte do código responsável por mandar as notícias ao telegram

def enviar_noticia(mensagem):
  url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
  payload = {"chat_id": CHAT_ID, "text": mensagem, "parse_mode": "Markdown"}
  response = requests.post(url, json=payload)
  return response.json()

# Exemplo de uso


n = 0

while n <= 4:

  tupla = tuple(lista_maior[n])

  texto_da_noticia = tupla

  enviar_noticia(texto_da_noticia)

  n += 1







