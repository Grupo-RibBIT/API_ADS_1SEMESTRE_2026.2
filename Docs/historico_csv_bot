def salvar_no_historico(remetente: str, texto: str):
    """Armazena até 10 mensagens recentes na memória e imprime no terminal."""
    historico_conversa.append(f"{remetente}: {texto}")
    if len(historico_conversa) > 10:
        historico_conversa.pop(0)

    print("\n--- HISTÓRICO ATUALIZADO (MÁX 10 MENSAGENS) ---")
    for msg in historico_conversa:
        print(msg)
    print("----------------------------------------------\n")


def formatar_valor_br(val) -> str:
    """Padroniza rigorosamente qualquer formato de preço do CSV para 'R$ X.XXX.XXX'."""
    val_str = str(val)
    numeros = re.sub(r"[^\d]", "", val_str)
    if numeros:
        v = int(numeros)
        return f"R$ {v:,.0f}".replace(",", ".")
    return "Consulte"


