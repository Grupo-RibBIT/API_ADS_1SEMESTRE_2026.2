def enviar_localizacao_no_telegram(endereço_apartamento, chat_id_telegram):
    print(f"[Geopy] Obtendo coordenadas para: {endereço_apartamento}")
    try:
        endereco = geolocator.geocode(endereço_apartamento)
        if endereco:
            bot.send_location(
                chat_id=chat_id_telegram,
                latitude=endereco.latitude,
                longitude=endereco.longitude,
            )
            print(
                f"[Geopy] Coordenadas enviadas: {endereco.latitude},"
                f" {endereco.longitude}"
            )
        else:
            print("[Geopy] Endereço não encontrado no OpenStreetMap.")
    except Exception as e:
        print(f"[Geopy Erro] {e}")


