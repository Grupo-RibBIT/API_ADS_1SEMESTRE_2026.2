def extrair_numeros(texto: str) -> list[float]:
    """Extrai números do texto, tratando termos como 'mil' (ex: '500 mil' -> 500000)."""
    texto_lower = texto.lower()
    texto_trabalhado = re.sub(
        r"(\d+)\s*mil", lambda m: str(int(m.group(1)) * 1000), texto_lower
    )
    texto_limpo = re.sub(r"\.(?=\d{3})", "", texto_trabalhado)
    numeros = re.findall(r"\d+", texto_limpo)
    return [float(n) for n in numeros]


def executar_filtro_csv(
    filtro: str,
    texto_usuario: str = "",
    caminho_csv: str = caminho_csv_global,
) -> pd.DataFrame:
    print(
        f"\n[Filtro] Buscando no CSV por: Filtro='{filtro}',"
        f" Entrada='{texto_usuario}'..."
    )
    try:
        df = pd.read_csv(caminho_csv)
    except Exception as e:
        print(f"[Erro CSV] Falha ao ler o arquivo: {e}")
        return pd.DataFrame()

    resultado = pd.DataFrame()

    if filtro == "Postagem" and "postagem" in df.columns:
        df = df.dropna(subset=["postagem"])
        resultado = df[
            df["postagem"]
            .astype(str)
            .str.contains(texto_usuario, case=False, na=False)
        ]

    elif filtro == "Preço" and "preco" in df.columns:
        df = df.dropna(subset=["preco"])
        df["preco_num"] = (
            df["preco"]
            .astype(str)
            .str.replace(r"[^\d,.]", "", regex=True)
            .str.replace(".", "", regex=False)
            .str.replace(",", ".", regex=False)
        )
        df["preco_num"] = pd.to_numeric(df["preco_num"], errors="coerce")
        df = df.dropna(subset=["preco_num"])

        valores = extrair_numeros(texto_usuario)
        if valores:
            if len(valores) >= 2:
                v_min, v_max = min(valores[0], valores[1]), max(
                    valores[0], valores[1]
                )
                resultado = df[
                    (df["preco_num"] >= v_min) & (df["preco_num"] <= v_max)
                ]
            else:
                resultado = df[df["preco_num"] <= valores[0]]

    elif filtro == "Abaixo do preço" and "abaixo_do_preco" in df.columns:
        df = df.dropna(subset=["abaixo_do_preco"])
        resultado = df[
            df["abaixo_do_preco"]
            .astype(str)
            .str.contains("sim|true|1|abaixo", case=False, na=False)
        ]

    elif filtro == "Área" and "Área" in df.columns:
        df = df.dropna(subset=["Área"])
        df["area_num"] = pd.to_numeric(
            df["Área"].astype(str).str.extract(r"(\d+)")[0], errors="coerce"
        )
        df = df.dropna(subset=["area_num"])
        valores = extrair_numeros(texto_usuario)
        if valores:
            resultado = df[df["area_num"] >= valores[0]]

    elif filtro == "Endereço" and "Endereco" in df.columns:
        df = df.dropna(subset=["Endereco"])
        resultado = df[
            df["Endereco"]
            .astype(str)
            .str.contains(texto_usuario, case=False, na=False)
        ]

    elif filtro == "Quartos" and "Quartos" in df.columns:
        df = df.dropna(subset=["Quartos"])
        df["quartos_num"] = pd.to_numeric(
            df["Quartos"].astype(str).str.extract(r"(\d+)")[0], errors="coerce"
        )
        valores = extrair_numeros(texto_usuario)
        if valores:
            resultado = df[df["quartos_num"] >= int(valores[0])]

    elif filtro == "Banheiros" and "Banheiros" in df.columns:
        df = df.dropna(subset=["Banheiros"])
        df["banheiros_num"] = pd.to_numeric(
            df["Banheiros"].astype(str).str.extract(r"(\d+)")[0],
            errors="coerce",
        )
        valores = extrair_numeros(texto_usuario)
        if valores:
            resultado = df[df["banheiros_num"] >= int(valores[0])]

    elif filtro == "Garagem" and "Vagas_de_estacionamento" in df.columns:
        df = df.dropna(subset=["Vagas_de_estacionamento"])
        df["vagas_num"] = pd.to_numeric(
            df["Vagas_de_estacionamento"].astype(str).str.extract(r"(\d+)")[0],
            errors="coerce",
        )
        valores = extrair_numeros(texto_usuario)
        if valores:
            resultado = df[df["vagas_num"] >= int(valores[0])]

    if not resultado.empty:
        print(f"[Filtro CSV] {len(resultado.head(5))} imóveis retornados.")
        return resultado.head(5)
    else:
        print("[Filtro CSV] Nenhum imóvel encontrado para estes critérios.")
        return pd.DataFrame()


