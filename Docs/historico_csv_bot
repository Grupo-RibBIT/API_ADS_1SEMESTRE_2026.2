# 4. MÓDULO PRINCIPAL DSPY (POSTAGEM EM LOTE OTIMIZADA)
# ==============================================================================


class BotImobiliária(dspy.Module):

    def __init__(self):
        super().__init__()
        self.arquiteto = dspy.ChainOfThought(DescriçãoApartamento)
        self.finalizador = dspy.ChainOfThought(RespostaCliente)

    def forward(self, mensagem, df_filtrado: pd.DataFrame) -> str:
        chat_id = mensagem.chat.id

        if df_filtrado.empty:
            texto_historico = "\n".join(historico_conversa)
            res = self.finalizador(
                dados_imoveis="Nenhum imóvel encontrado",
                historico_conversa=texto_historico,
                mensagem_usuario=mensagem.text,
            )
            bot.send_message(chat_id, res.resposta_final)
            return res.resposta_final

        # Envia os cards em lote para todos os imóveis encontrados
        for idx, (_, linha) in enumerate(df_filtrado.iterrows(), 1):
            linha_csv_str = linha.to_frame().T.to_csv(index=False)

            print(f"\n[IA - Etapa 1] Processando imóvel #{idx}...")
            caracteristicas = self.arquiteto(linha_do_csv=linha_csv_str)

            endereco_exibicao = getattr(
                caracteristicas,
                "endereço_apartamento",
                str(linha.get("Endereco", "Endereço não especificado")),
            )

            # FORMATAÇÃO RÍGIDA DE PREÇO VIA PYTHON
            valor_formatado = formatar_valor_br(linha.get("preco", ""))

            slides = list_fotos_apt[random.randint(0, 2)]

            # 1. Envia a apresentação visual do imóvel
            montar_mini_apresentação_e_mandar_pelo_telegram(
                fotos=slides,
                num_banheiros=caracteristicas.banheiros,
                num_quartos=caracteristicas.quartos,
                num_estacionamento=caracteristicas.estacionamento,
                área=caracteristicas.área,
                valor_formatado=valor_formatado,
                endereco_imovel=endereco_exibicao,
                chat_id_telegram=chat_id,
                indice=idx,
            )

            # 2. Envia a localização no mapa
            if (
                endereco_exibicao
                and endereco_exibicao != "Endereço não especificado"
            ):
                enviar_localizacao_no_telegram(endereco_exibicao, chat_id)

        # 3. Finalização: Gera a mensagem cortês de fechamento informando que encontrou as opções
        texto_historico = "\n".join(historico_conversa)
        print("\n[IA - Etapa 2] Gerando mensagem de fechamento...")
        res = self.finalizador(
            dados_imoveis=df_filtrado.to_csv(index=False),
            historico_conversa=texto_historico,
            mensagem_usuario=mensagem.text,
        )

        bot.send_message(chat_id, res.resposta_final)
        return res.resposta_final


bot_recepção = BotImobiliária()


