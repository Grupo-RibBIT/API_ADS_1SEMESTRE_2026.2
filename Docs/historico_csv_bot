@bot.callback_query_handler(func=lambda call: call.data.startswith("role_"))
def callback_role(call):
    chat_id = call.message.chat.id
    papeis = {
        "role_preço": "Preço",
        "role_postagem": "Postagem",
        "role_abaixo_do_preço": "Abaixo do preço",
        "role_area": "Área",
        "role_endereço": "Endereço",
        "role_quartos": "Quartos",
        "role_banheiros": "Banheiros",
        "role_garagem": "Garagem",
    }
    escolha = papeis.get(call.data)
    if escolha:
        user_roles[chat_id] = escolha
        print(f"\n[Telegram] Usuário {chat_id} selecionou o filtro: {escolha}")

        if escolha == "Abaixo do preço":
            bot.send_message(
                chat_id, "Buscando oportunidades abaixo do preço..."
            )
            df_resultado = executar_filtro_csv(filtro="Abaixo do preço")
            resposta_bot = bot_recepção(
                mensagem=call.message, df_filtrado=df_resultado
            )
            salvar_no_historico("Bot", resposta_bot)
        else:
            bot.send_message(
                chat_id,
                f"Você escolheu o filtro *{escolha}*. Envie os detalhes da"
                " busca.",
                parse_mode="Markdown",
            )

    bot.edit_message_reply_markup(
        chat_id, call.message.message_id, reply_markup=None
    )


@bot.message_handler(func=lambda message: True)
def processar_mensagem_com_ia(message):
    chat_id = message.chat.id
    texto_usuario = message.text

    print(f"\n[Telegram] Mensagem recebida de {chat_id}: '{texto_usuario}'")

    salvar_no_historico("Usuário", texto_usuario)

    filtro_ativo = user_roles.get(chat_id)

    if not filtro_ativo:
        msg_alerta = "Por favor, digite /start e escolha um filtro para iniciar."
        bot.send_message(chat_id, msg_alerta)
        salvar_no_historico("Bot", msg_alerta)
        return

    # 1. Executa filtro no Pandas retornando os resultados em um DataFrame
    df_filtrado = executar_filtro_csv(
        filtro=filtro_ativo, texto_usuario=texto_usuario
    )

    # 2. Executa a IA e faz as postagens dos cards em lote
    resposta_final = bot_recepção(mensagem=message, df_filtrado=df_filtrado)

    salvar_no_historico("Bot", resposta_final)


